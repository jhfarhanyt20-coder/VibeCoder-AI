{
  "name": "vibe-core",
  "version": "0.3.6",
  "description": "VibeCoder AI engine: own CLI, own SDK, 3 LLM formats, auto-compaction. Zero dependencies.",
  "license": "UNLICENSED",
  "author": {
    "name": "Jamil Hussain"
  },
  "main": "electron/main.cjs",
  "bin": {
    "vibe": "cli/vibe.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/shell-output-regression.cjs && node test/core-test.mjs && node test/agents-test.mjs && node test/skills-test.mjs && node test/harness-test.mjs && node test/electron-backend-smoke.cjs && node test/compaction-ui-regression.mjs && node test/subagent-ui-regression.mjs && node test/harness-ui-regression.mjs && node test/app-update-ui-regression.mjs && node test/app-updater-test.cjs",
    "serve": "node cli/vibe.js serve",
    "app": "electron electron/main.cjs",
    "dev": "electron electron/main.cjs --dev",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.vibecoder.app",
    "productName": "VibeCoder AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "core/**",
      "sdk/**",
      "cli/**",
      "renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VibeCoder AI",
      "artifactName": "VibeCoderAI-v2-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "jhfarhanyt20-coder",
      "repo": "VibeCoder-AI",
      "releaseType": "release",
      "publishAutoUpdate": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
